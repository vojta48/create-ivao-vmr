<?xml version="1.0" encoding="utf-8"?>
<ModelMatchRuleSet>
<!-- Smartwings group: Smartwings (TVS), Smartwings Poland (TVP), Hungary (TVL), Slovakia (TVQ) and Czech Airlines (CSA) fly each other's aircraft. -->
<ModelMatchRule CallsignPrefix="CSA" TypeCode="B738" ModelName="B738TVSWL//B738TVSWL3" />
<ModelMatchRule CallsignPrefix="CSA" TypeCode="B737" ModelName="B737TVS" />
<ModelMatchRule CallsignPrefix="CSA" TypeCode="B739" ModelName="B739TVSWL" />
<ModelMatchRule CallsignPrefix="TVS" TypeCode="B738" ModelName="B738TVSWL" />
