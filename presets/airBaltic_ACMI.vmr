<?xml version="1.0" encoding="utf-8"?>
<ModelMatchRuleSet>
<!-- Airbus A220-300 of airBaltic wet-leased (ACMI) to other airlines: Brussels Airlines, Austrian, Lufthansa, Air Serbia and SAS fly them in airBaltic colours. -->
<ModelMatchRule CallsignPrefix="BEL" TypeCode="BCS3" ModelName="BCS3BTI" />
<ModelMatchRule CallsignPrefix="AUA" TypeCode="BCS3" ModelName="BCS3BTI" />
<ModelMatchRule CallsignPrefix="DLH" TypeCode="BCS3" ModelName="BCS3BTI" />
<ModelMatchRule CallsignPrefix="ASL" TypeCode="BCS3" ModelName="BCS3BTI" />
<ModelMatchRule CallsignPrefix="SAS" TypeCode="BCS3" ModelName="BCS3BTI" />
</ModelMatchRuleSet>
