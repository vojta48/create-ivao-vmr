<?xml version="1.0" encoding="utf-8"?>
<ModelMatchRuleSet>
<!-- Business jets missing from the IVAO MTL, shown as the closest one it has: the Global 5000 and 7500 as the Global 6000 (white, or VistaJet's own). -->
<ModelMatchRule CallsignPrefix="VJT" TypeCode="GL7T" ModelName="GLEXVJT" />
<ModelMatchRule CallsignPrefix="VJT" TypeCode="GL5T" ModelName="GLEXVJT" />
<ModelMatchRule TypeCode="GL7T" ModelName="GLEX" />
<ModelMatchRule TypeCode="GL5T" ModelName="GLEX" />
</ModelMatchRuleSet>
