<ModelMatchRule CallsignPrefix="TVL" TypeCode="B38M" ModelName="B38MTVS" />
<ModelMatchRule CallsignPrefix="TVQ" TypeCode="B38M" ModelName="B38MTVS" />
<ModelMatchRule CallsignPrefix="CSA" TypeCode="B38M" ModelName="B38MTVS" />
<ModelMatchRule CallsignPrefix="TVS" TypeCode="BCS3" ModelName="BCS3CSA" />
