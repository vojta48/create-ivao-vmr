<ModelMatchRule CallsignPrefix="TVQ" TypeCode="B737" ModelName="B737TVS" />
<ModelMatchRule CallsignPrefix="TVQ" TypeCode="B739" ModelName="B739TVSWL" />
<ModelMatchRule CallsignPrefix="TVL" TypeCode="B738" ModelName="B738TVSWL" />
<ModelMatchRule CallsignPrefix="TVL" TypeCode="B737" ModelName="B737TVS" />
<ModelMatchRule CallsignPrefix="TVL" TypeCode="B739" ModelName="B739TVSWL" />
<ModelMatchRule CallsignPrefix="TVS" TypeCode="A320" ModelName="A320CSA" />
<ModelMatchRule CallsignPrefix="TVP" TypeCode="A320" ModelName="A320CSA" />
<ModelMatchRule CallsignPrefix="TVL" TypeCode="A320" ModelName="A320CSA" />
<ModelMatchRule CallsignPrefix="TVQ" TypeCode="A320" ModelName="A320CSA" />
